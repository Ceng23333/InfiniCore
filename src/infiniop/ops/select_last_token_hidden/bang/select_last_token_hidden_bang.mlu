#include "../../../../utils.h"
#include "../../../devices/bang/common_bang.h"
#include "../../../tensor.h"
#include "select_last_token_hidden_bang.h"

#include <algorithm>
#include <cstdint>

namespace {

__nram__ char select_last_token_hidden_nram[NRAM_MAX_SIZE];

__mlu_global__ void selectLastTokenHiddenKernel(
    char *__restrict__ output,
    const char *__restrict__ hidden_states,
    const int32_t *__restrict__ input_offsets,
    size_t num_requests,
    size_t tiles_per_request,
    size_t tile_bytes,
    size_t row_bytes,
    size_t total_tokens) {

    char *nram = reinterpret_cast<char *>(
        (reinterpret_cast<size_t>(select_last_token_hidden_nram) + ALIGN_SIZE - 1)
        / ALIGN_SIZE * ALIGN_SIZE);
    const size_t nram_capacity = NRAM_MAX_SIZE
                               - (nram - select_last_token_hidden_nram);

    const size_t logical_tasks = num_requests * tiles_per_request;
    for (size_t logical_task = taskId;
         logical_task < logical_tasks;
         logical_task += taskDim) {
        const size_t request = logical_task / tiles_per_request;
        const size_t tile = logical_task - request * tiles_per_request;
        const size_t tile_offset = tile * tile_bytes;
        if (tile_offset >= row_bytes) {
            continue;
        }

        const int32_t row = input_offsets[request + 1] - 1;
        if (row < 0 || static_cast<size_t>(row) >= total_tokens) {
            continue;
        }

        const size_t bytes_to_copy = std::min(tile_bytes, row_bytes - tile_offset);
        const char *src = hidden_states
                        + static_cast<size_t>(row) * row_bytes
                        + tile_offset;
        char *dst = output + request * row_bytes + tile_offset;
        for (size_t copied = 0; copied < bytes_to_copy;) {
            const size_t chunk = std::min(nram_capacity, bytes_to_copy - copied);
            __memcpy(nram, src + copied, chunk, GDRAM2NRAM);
            __memcpy(dst + copied, nram, chunk, NRAM2GDRAM);
            copied += chunk;
        }
    }
}

} // namespace

namespace op::select_last_token_hidden::bang {

Descriptor::~Descriptor() {}

infiniStatus_t Descriptor::create(
    infiniopHandle_t handle_,
    Descriptor **desc_ptr,
    infiniopTensorDescriptor_t output_desc,
    infiniopTensorDescriptor_t hidden_states_desc,
    infiniopTensorDescriptor_t input_offsets_desc) {
    const auto output_shape = output_desc->shape();
    const auto hidden_shape = hidden_states_desc->shape();
    const auto offsets_shape = input_offsets_desc->shape();

    CHECK_OR_RETURN(
        output_shape.size() == 3 && hidden_shape.size() == 3
            && offsets_shape.size() == 1,
        INFINI_STATUS_BAD_TENSOR_SHAPE);
    CHECK_OR_RETURN(offsets_shape[0] >= 2, INFINI_STATUS_BAD_TENSOR_SHAPE);
    const size_t num_requests = offsets_shape[0] - 1;
    CHECK_OR_RETURN(
        output_shape[0] == 1 && output_shape[1] == num_requests
            && output_shape[2] == hidden_shape[2],
        INFINI_STATUS_BAD_TENSOR_SHAPE);
    CHECK_OR_RETURN(
        output_desc->isContiguous() && hidden_states_desc->isContiguous()
            && input_offsets_desc->isContiguous(),
        INFINI_STATUS_BAD_TENSOR_STRIDES);
    CHECK_OR_RETURN(
        input_offsets_desc->dtype() == INFINI_DTYPE_I32,
        INFINI_STATUS_BAD_TENSOR_DTYPE);
    const auto hidden_dtype = hidden_states_desc->dtype();
    CHECK_OR_RETURN(
        hidden_dtype == INFINI_DTYPE_F16 || hidden_dtype == INFINI_DTYPE_BF16
            || hidden_dtype == INFINI_DTYPE_F32,
        INFINI_STATUS_BAD_TENSOR_DTYPE);
    CHECK_OR_RETURN(
        output_desc->dtype() == hidden_dtype,
        INFINI_STATUS_BAD_TENSOR_DTYPE);

    const size_t total_tokens = hidden_shape[0] * hidden_shape[1];
    CHECK_OR_RETURN(
        total_tokens > 0 && hidden_shape[2] > 0,
        INFINI_STATUS_BAD_TENSOR_SHAPE);

    auto handle = reinterpret_cast<device::bang::Handle *>(handle_);
    auto internal = handle->internal();
    *desc_ptr = new Descriptor(
        num_requests,
        total_tokens,
        hidden_shape[2] * infiniSizeOf(hidden_dtype),
        nullptr,
        handle->device,
        handle->device_id,
        internal->getCorePerCluster(),
        internal->getClusterCount());
    return INFINI_STATUS_SUCCESS;
}

infiniStatus_t Descriptor::calculate(
    void *output,
    const void *hidden_states,
    const void *input_offsets,
    void *stream) const {
    if (_num_requests == 0 || _row_bytes == 0) {
        return INFINI_STATUS_SUCCESS;
    }

    constexpr size_t MIN_TILE_BYTES = 1024;
    const size_t max_tasks = _kernel_dim_x * _kernel_dim_y;
    const size_t max_tiles_per_request = std::max<size_t>(1, max_tasks / _num_requests);
    const size_t tiles_by_size = (_row_bytes + MIN_TILE_BYTES - 1) / MIN_TILE_BYTES;
    const size_t tiles_per_request = std::min(max_tiles_per_request, tiles_by_size);
    const size_t tile_bytes_unaligned = (_row_bytes + tiles_per_request - 1) / tiles_per_request;
    const size_t tile_bytes = (tile_bytes_unaligned + ALIGN_SIZE - 1) / ALIGN_SIZE * ALIGN_SIZE;
    const size_t logical_tasks = _num_requests * tiles_per_request;

    cnrtDim3_t kernel_dim;
    kernel_dim.x = _kernel_dim_x;
    kernel_dim.y = std::min(
        _kernel_dim_y,
        (logical_tasks + kernel_dim.x - 1) / kernel_dim.x);
    kernel_dim.z = 1;

    auto queue = reinterpret_cast<cnrtQueue_t>(stream);
    selectLastTokenHiddenKernel<<<kernel_dim, cnrtFuncTypeUnion1, queue>>>(
        static_cast<char *>(output),
        static_cast<const char *>(hidden_states),
        static_cast<const int32_t *>(input_offsets),
        _num_requests,
        tiles_per_request,
        tile_bytes,
        _row_bytes,
        _total_tokens);
    CHECK_INTERNAL(cnrtQueueSync(queue), cnrtSuccess);
    return INFINI_STATUS_SUCCESS;
}

} // namespace op::select_last_token_hidden::bang
