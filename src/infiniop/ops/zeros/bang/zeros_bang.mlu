#include "zeros_bang.h"

LAUNCH_ELEMENTWISE_KERNEL(Zeros)

namespace op::zeros::bang {

typedef struct ZerosOp {
    static constexpr size_t num_inputs = 1;
    template <typename Tdata, typename... Args>
    static infiniStatus_t launch(Args... args) {
        launchZerosKernel<Tdata>(args...);
        return INFINI_STATUS_SUCCESS;
    }
} ZerosOp;

template <typename T>
static infiniStatus_t fillCnnl(
    const std::shared_ptr<device::bang::Handle::Internal> &internal,
    cnnlTensorDescriptor_t value_desc,
    cnnlTensorDescriptor_t output_desc,
    void *output,
    T value,
    void *stream) {
    auto queue = reinterpret_cast<cnrtQueue_t>(stream);
    CHECK_STATUS(internal->useCnnl(
        queue,
        [&](cnnlHandle_t cnnl_handle) {
            CHECK_BANG(cnnlFill_v4(
                cnnl_handle, value_desc, &value, output_desc, output));
            return INFINI_STATUS_SUCCESS;
        }));
    CNRT_CHECK(cnrtQueueSync(queue));
    return INFINI_STATUS_SUCCESS;
}

Descriptor::~Descriptor() {
    if (_value_desc) {
        cnnlDestroyTensorDescriptor(_value_desc);
    }
    if (_output_desc) {
        cnnlDestroyTensorDescriptor(_output_desc);
    }
}

infiniStatus_t Descriptor::create(
    infiniopHandle_t handle_,
    Descriptor **desc_ptr,
    infiniopTensorDescriptor_t out_desc,
    std::vector<infiniopTensorDescriptor_t> input_desc_vec) {
    if (input_desc_vec.size() != 1) {
        return INFINI_STATUS_BAD_PARAM;
    }

    auto handle = reinterpret_cast<device::bang::Handle *>(handle_);
    auto dtype = out_desc->dtype();
    const auto &x_desc = input_desc_vec.at(0);

    CHECK_DTYPE(dtype,
                INFINI_DTYPE_BYTE,
                INFINI_DTYPE_BOOL,
                INFINI_DTYPE_I8,
                INFINI_DTYPE_I16,
                INFINI_DTYPE_I32,
                INFINI_DTYPE_I64,
                INFINI_DTYPE_U8,
                INFINI_DTYPE_U16,
                INFINI_DTYPE_U32,
                INFINI_DTYPE_U64,
                INFINI_DTYPE_F16,
                INFINI_DTYPE_F32,
                INFINI_DTYPE_F64,
                INFINI_DTYPE_BF16);
    CHECK_SAME_SHAPE(out_desc->shape(), x_desc->shape());

    auto info_result = op::elementwise::ElementwiseInfo::create(
        out_desc, input_desc_vec);
    CHECK_RESULT(info_result);
    auto info = info_result.take();

    op::elementwise::bang::DeviceImpl *device_info = nullptr;
    cnnlTensorDescriptor_t value_desc = nullptr;
    cnnlTensorDescriptor_t output_desc = nullptr;
    size_t workspace_size = 0;

    if (dtype == INFINI_DTYPE_F64) {
        auto device_impl_result = op::elementwise::bang::DeviceImpl::create(handle->internal(), info);
        CHECK_RESULT(device_impl_result);
        device_info = device_impl_result.take();
    } else {
        CHECK_BANG(cnnlCreateTensorDescriptor(&value_desc));
        CHECK_BANG(cnnlCreateTensorDescriptor(&output_desc));
        auto cnnl_dtype = device::bang::getCnnlDtype(dtype);
        CHECK_BANG(cnnlSetTensorDescriptorPointerMode(
            value_desc, CNNL_POINTER_MODE_HOST));
        CHECK_BANG(cnnlSetTensorDescriptor(
            value_desc, CNNL_LAYOUT_ARRAY, cnnl_dtype, 0, nullptr));
        CHECK_STATUS(device::bang::setCnnlTensorEx(output_desc, out_desc));
    }

    *desc_ptr = new Descriptor(
        dtype, std::move(info), device_info, handle->internal(), value_desc,
        output_desc, workspace_size, handle->device, handle->device_id);
    return INFINI_STATUS_SUCCESS;
}

infiniStatus_t Descriptor::calculate(
    void *workspace,
    size_t workspace_size,
    void *output,
    std::vector<const void *> inputs,
    void *stream) const {
    if (workspace_size < _workspace_size) {
        return INFINI_STATUS_INSUFFICIENT_WORKSPACE;
    }
    if (inputs.size() != 1) {
        return INFINI_STATUS_BAD_PARAM;
    }
    if (_info.getOutputSize() == 0) {
        return INFINI_STATUS_SUCCESS;
    }

    switch (_dtype) {
    case INFINI_DTYPE_BYTE:
    case INFINI_DTYPE_U8:
        return fillCnnl(_internal, _value_desc, _output_desc, output,
                        uint8_t{0}, stream);
    case INFINI_DTYPE_BOOL:
        return fillCnnl(_internal, _value_desc, _output_desc, output,
                        false, stream);
    case INFINI_DTYPE_I8:
        return fillCnnl(_internal, _value_desc, _output_desc, output,
                        int8_t{0}, stream);
    case INFINI_DTYPE_I16:
        return fillCnnl(_internal, _value_desc, _output_desc, output,
                        int16_t{0}, stream);
    case INFINI_DTYPE_I32:
        return fillCnnl(_internal, _value_desc, _output_desc, output,
                        int32_t{0}, stream);
    case INFINI_DTYPE_I64:
        return fillCnnl(_internal, _value_desc, _output_desc, output,
                        int64_t{0}, stream);
    case INFINI_DTYPE_U16:
        return fillCnnl(_internal, _value_desc, _output_desc, output,
                        uint16_t{0}, stream);
    case INFINI_DTYPE_U32:
        return fillCnnl(_internal, _value_desc, _output_desc, output,
                        uint32_t{0}, stream);
    case INFINI_DTYPE_U64:
        return fillCnnl(_internal, _value_desc, _output_desc, output,
                        uint64_t{0}, stream);
    case INFINI_DTYPE_F16:
    case INFINI_DTYPE_BF16:
        return fillCnnl(_internal, _value_desc, _output_desc, output,
                        uint16_t{0}, stream);
    case INFINI_DTYPE_F32:
        return fillCnnl(_internal, _value_desc, _output_desc, output,
                        0.0f, stream);
    case INFINI_DTYPE_F64:
        return _device_info->calculate<ZerosOp, double>(
            _info, workspace, output, inputs, stream);
    default:
        return INFINI_STATUS_BAD_TENSOR_DTYPE;
    }
}

} // namespace op::zeros::bang
